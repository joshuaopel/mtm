{
  "name": "mtm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Monster Truck Mania inspired arcade racer for the web",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "smoke": "node tools/smoke.mjs",
    "desktop": "npm run build && electron electron/main.cjs",
    "desktop:windowed": "npm run build && electron electron/main.cjs --windowed",
    "desktop:pack": "npm run build && electron-builder --linux dir",
    "desktop:dist": "npm run build && electron-builder --linux"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshuaopel/mtm.git"
  },
  "license": "ISC",
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/three": "^0.185.4",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.joshuaopel.monstertruckmania",
    "productName": "Monster Truck Mania",
    "copyright": "",
    "directories": {
      "output": "release",
      "buildResources": "electron/resources"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json",
      "!node_modules/**/*",
      "!dist/content/**/*"
    ],
    "extraResources": [],
    "linux": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "executableName": "monster-truck-mania",
      "artifactName": "monster-truck-mania-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "monster-truck-mania-${version}-windows-${arch}.${ext}"
    },
    "extraFiles": [
      {
        "from": "dist/content",
        "to": "content"
      }
    ]
  }
}
